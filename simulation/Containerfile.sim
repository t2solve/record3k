# ┌──────────────────────────────────────────────────────────────────────────┐
# │  Containerfile.sim  —  pipeline optimiser simulation runner              │
# │                                                                          │
# │  Builds:  liblbt (shared lib) + pipeoptimizer binary                    │
# │           + Python venv with analysis deps (matplotlib/pandas/scipy …)  │
# │           No VimbaX / camera code compiled.                             │
# │                                                                          │
# │  Build context: the repo root. Only record3k.pro, config/common.pri,    │
# │  src/ and simulation/examples/ are copied in. simulation/examples/ is   │
# │  baked in as the default /data/simulation (example run configs + base   │
# │  pipelines); at runtime bind-mount the host data/simulation/ over it so │
# │  run configs, the sqlite DB and analysis output are shared with the     │
# │  host (seed it once: cp -rn simulation/examples/. data/simulation/).    │
# │                                                                          │
# │  BUILD (from the repo root):                                             │
# │    podman build -f simulation/Containerfile.sim -t record3k-sim .        │
# │                                                                          │
# │  RUN — full iteration (generate → simulate → leaderboard → analyse →    │
# │  cleanup; deletes generated synth frames at the end, keeps the sqlite   │
# │  DB + configs + analysis plots — see "cleanup_synth" below):            │
# │    podman run --rm \                                                     │
# │      --device nvidia.com/gpu=all \                                       │
# │      -v $(pwd)/data/simulation:/data/simulation \                        │
# │      record3k-sim /data/simulation/baseline1.json                       │
# │                                                                          │
# │  RUN — analysis only (no GPU required):                                 │
# │    podman run --rm \                                                     │
# │      -v $(pwd)/data/simulation:/data/simulation \                        │
# │      record3k-sim /data/simulation/baseline1.json --only analyse        │
# │                                                                          │
# │  RUN — re-simulate with more pipes, skip generation:                    │
# │    podman run --rm --device nvidia.com/gpu=all \                         │
# │      -v $(pwd)/data/simulation:/data/simulation \                        │
# │      record3k-sim /data/simulation/run3.json --skip generate --n-pipes 50 │
# │                                                                          │
# │  Expected layout under data/simulation/ (host and container share the  │
# │  same relative paths, so run configs work unmodified in either place): │
# │    data/simulation/param_ranges.json ← sweep config (read)              │
# │    data/simulation/pipelines/*.json  ← fixed pipelines to test (read)   │
# │    data/simulation/runXY.json        ← sim_runner config (see below)    │
# │    data/simulation/sim_results.sqlite← SQLite DB (written/appended)     │
# │    data/simulation/<run_name>/synth/    ← generated records (deleted at │
# │                                           end of run if cleanup_synth)  │
# │    data/simulation/<run_name>/analysis/ ← plots + summary.txt (written) │
# │                                                                          │
# │  Minimal data/simulation/runXY.json for container use:                  │
# │  {                                                                       │
# │    "run_name":          "runXY",                                        │
# │    "description":       "sweep",                                        │
# │    "pipeoptimizer_bin": "/app/bin/pipeoptimizer",                       │
# │    "param_ranges":      "param_ranges.json",                            │
# │    "data_root":         ".",                                            │
# │    "generate": {                                                         │
# │      "n_records": 13, "static_records": 1, "body_type": "both",        │
# │      "warmup": 500, "animal_frames": 800, "seed": 42                    │
# │    },                                                                    │
# │    "simulate": { "n_pipes": 25, "n_workers": 12 },                      │
# │    "cleanup_synth": true                                                 │
# │  }                                                                       │
# └──────────────────────────────────────────────────────────────────────────┘

FROM cuda-builder:latest

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:$PKG_CONFIG_PATH

WORKDIR /app

# Slim build context — only what liblbt + pipeoptimizer (no VimbaX) need: the
# qmake project + shared settings, the full src/ tree (src/pipelineviewer and
# src/api are also under src/ and listed in record3k.pro's SUBDIRS, but neither
# needs vimbax/ since VimbaX support is CONFIG-gated in config/common.pri and we
# don't pass CONFIG+=vimbax below), and the simulation data/config directory.
COPY record3k.pro record3k.pro
COPY config/common.pri config/common.pri
COPY src/ src/
COPY simulation/examples/ /data/simulation/

# ── system build deps ─────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsqlite3-dev \
        libjsoncpp-dev \
        python3 \
        python3-venv \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ── sanity-check OpenCV before spending time on the compile ───────────────────
RUN pkg-config --modversion opencv4 \
 || (echo "ERROR: opencv4 not found — check PKG_CONFIG_PATH=$PKG_CONFIG_PATH" && exit 1)

# ── ensure liblbt public headers are in canonical location ────────────────────
# mirrors the logic in the main Dockerfile
RUN if [ ! -d /app/src/liblbt/include/liblbt ]; then \
      mkdir -p /app/src/liblbt/include/liblbt; \
      for f in /app/src/liblbt/include/*.h; do \
        [ -e "$f" ] && mv "$f" /app/src/liblbt/include/liblbt/; \
      done; \
    fi
RUN ls -al /app/src/liblbt/include/liblbt

# ── C++ build (liblbt + pipeoptimizer only, no VimbaX / camera) ──────────────
#
# qmake is run per-subproject, not on the top-level record3k.pro: qmake's
# TEMPLATE=subdirs only generates the top orchestrating Makefile eagerly —
# each subdir's own Makefile is generated lazily, only when that subdir's
# named target (e.g. `make sub-src-liblbt`) is actually invoked. `make -C
# src/liblbt` bypasses that entirely and looks for a Makefile that was never
# created. Qmake-ing each subproject in place sidesteps that pitfall and also
# means we never need src/pipelineviewer or src/api to be buildable at all.
# DESTDIR paths in the .pro files resolve as:
#   liblbt:       DESTDIR=../../lib  from src/liblbt/  → /app/lib/
#   pipeoptimizer: DESTDIR=../../bin  from src/pipeoptimizer/ → /app/bin/
#
RUN mkdir -p /app/bin /app/lib

RUN pkg-config --modversion opencv4

# build liblbt first (pipeoptimizer links against it)
RUN cd src/liblbt && qmake6 CONFIG+=cuda LOG_LEVEL=INFO liblbt.pro
RUN make -C src/liblbt   -j$(nproc) \
 && echo "── liblbt done ─────────────────────────────" \
 && ls -lh /app/lib/liblbt* 2>/dev/null || (echo "ERROR: liblbt not found in /app/lib" && exit 1)

RUN cd src/pipeoptimizer && qmake6 CONFIG+=cuda LOG_LEVEL=INFO pipeoptimizer.pro
RUN make -C src/pipeoptimizer -j$(nproc) \
 && echo "── pipeoptimizer done ──────────────────────" \
 && ls -lh /app/bin/pipeoptimizer 2>/dev/null || (echo "ERROR: pipeoptimizer binary not found in /app/bin" && exit 1)

# ── Python venv ───────────────────────────────────────────────────────────────
COPY src/pipeoptimizer/requirements.txt /tmp/requirements.txt

RUN python3 -m venv /app/venv \
 && /app/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /app/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
 && /app/venv/bin/python3 -c \
      "import matplotlib, numpy, pandas, seaborn, scipy; print('Python deps OK')"

# ── Python scripts ────────────────────────────────────────────────────────────
# Copied individually so each is its own layer — cache stays valid when only
# one script changes.
# sim_runner.py locates analyse.py as <script_dir>/analysis/analyse.py,
# which resolves to /app/scripts/analysis/analyse.py ✓
RUN mkdir -p /app/scripts/analysis

COPY src/pipeoptimizer/sim_runner.py       /app/scripts/
COPY src/pipeoptimizer/analysis/analyse.py /app/scripts/analysis/

# ── runtime environment ───────────────────────────────────────────────────────
ENV PATH=/app/bin:/app/venv/bin:$PATH \
    LD_LIBRARY_PATH=/app/lib:$LD_LIBRARY_PATH

# ── data volume ───────────────────────────────────────────────────────────────
# mount your host data/simulation/ here at runtime to share run configs, the
# sqlite DB, and analysis output with the host: -v $(pwd)/data/simulation:/data/simulation
VOLUME ["/data/simulation"]

# ── final verification ────────────────────────────────────────────────────────
# pipeoptimizer may return non-zero without a subcommand — that is fine.
RUN /app/bin/pipeoptimizer --help 2>&1 | head -5 || true
RUN /app/venv/bin/python3 /app/scripts/sim_runner.py --help

# ── entrypoint ────────────────────────────────────────────────────────────────
# Positional arg 1 must be the path to the run config JSON.
# All additional args are forwarded to sim_runner.py (--only, --skip, --n-pipes …).
ENTRYPOINT ["/app/venv/bin/python3", "/app/scripts/sim_runner.py"]
CMD ["--help"]
