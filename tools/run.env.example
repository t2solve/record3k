# Copy to tools/run.env (gitignored) and adjust; sourced by tools/run.sh.
# chmod 600 tools/run.env if you put a real API_TOKEN here.
DATA_DIR="data"
REMOTE="/mnt/nas/record3k_archive"
API_BASE="http://127.0.0.1:8080"
API_TOKEN=""
DELTA_DAYS=7
SSH=""
RSYNC_BIN="rsync"
EXTRA_RSYNC_ARGS=()            # e.g. (--bwlimit=5000 --exclude=*.tmp)

# Optional: rclone-mount the net share before archiving (leave empty to skip)
RCLONE_REMOTE=""               # e.g. "record3k_archive:camflow01"
RCLONE_BIN="rclone"
MOUNT_DIR="$HOME/mnt/record3k_archive"
