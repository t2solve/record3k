:3000 {
    # /srv/client is the mount point used by Docker Compose (see compose.yaml).
    # For local dev (caddy run from inside client/), change this to: root * .
    root * /srv/client

    # Human-readable access/error log — visible via `podman-compose logs client`.
    log {
        output stderr
        format console
    }

    # Proxy /api/* to Drogon, stripping the /api prefix so drogon routes
    # (e.g. /info/cameras/list) are reached correctly.
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy localhost:8080 {
            # Stream the upstream response immediately without buffering.
            # Required for large file downloads — without this Caddy holds
            # the full response in memory before forwarding to the browser.
            flush_interval -1
        }
    }

    # Serve static web files for everything else.
    handle {
        file_server browse
        header Cache-Control "no-cache, no-store, must-revalidate"
    }
}
