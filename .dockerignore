# Runtime data — bind-mounted via compose.yaml volumes, not needed at build time
data/
logs/
build/

# VCS / editor / tooling
.git/
.gitignore
.vscode/
.claude/
.venv/

# Local build artifacts (image builds fresh via qmake/make)
# NOTE: config/ must NOT be excluded — it holds config/common.pri, the
# hand-written qmake include (PKGCONFIG += opencv4, CUDA/VimbaX/API config)
# that every .pro includes, plus config/examples/ copied into the image.
build/
bin/
*.o
*.so
*.a
Makefile
Makefile.*
CMakeFiles/
CMakeCache.txt

# Misc scratch / docs not needed inside the image
doc/
debugging/
foo/
