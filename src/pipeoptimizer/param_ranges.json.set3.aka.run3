{
  "_comment": "Sweep-3 — background subtraction focus. ksize and min_area fixed; BG params are the free variables.",

  "_sweep_history": {
    "sweep1": "ksize=[7,11,15,21] min_area=[7,50,200,500] — found ksize=7 best, min_area=7 vs >=50 trade-off",
    "sweep2": "ksize=[5,7,9,11] min_area=[7,15,30,60,120,250,500] bg_history=[250,500,750] bg_vT=[8,16,32] — found ksize=5 best (SCORE 10.5 vs 21.1 for ksize=7), bg_history=250 best for moving, vT=8 best for moving BUT vT=32+hist=500 best for static. BUG FOUND: varThreshold and detectShadows were never applied (key name mismatch var_threshold vs varThreshold) — fixed in sweep-3.",
    "sweep3_goal": "Re-run background subtraction params now that the key-name bug is fixed. Find optimal (bg_history, varThreshold, detectShadows) that balances moving vs static records."
  },

  "_fixed_params": {
    "note": "These are fixed in defaultBasePipelineJson() — not varied by LHS",
    "pipeline.morph_ksize": {
      "value": 5,
      "rationale": "sweep-2 winner (avg SCORE 10.5 vs 21.1 for ksize=7). NOTE: user proposed ksize=7 but sweep-2 data shows ksize=5 is clearly better for moving animals. Ksize=7 is a safe conservative choice if you prefer less morphological sensitivity."
    },
    "pipeline.contour_min_area": {
      "value": 15,
      "rationale": "Good balance point between sweep-1 (min_area=7 gave 3.3 px error + 80% FPR) and sweep-2 runner-up cluster (min_area=60 gave 0.5 px error + 4% miss). min_area=15 is the elbow region."
    },
    "pipeline.binary_threshold": {
      "value": 80,
      "rationale": "Confirmed irrelevant in both sweeps (Spearman ρ=0.02 in sweep-2, η²≈0). Fixed at mid-range default."
    },
    "pipeline.contour_max_contours": {
      "value": 1,
      "rationale": "max_contours=0 produces centroid smear (α=51 px confirmed in sweep-1). max_contours=2 had marginal benefit on static records only."
    }
  },

  "pipeline.bg_history": {
    "values": [100, 250, 500, 1000, 2000],
    "rationale": "Core sweep-3 parameter. Moving animals: shorter history = faster MOG2 adaptation = better (sweep-2 winner: 250). Static/dead animals: shorter history = faster MOG2 absorption of still animal = WORSE (sweep-2 static best: 500). Wide range to quantify this trade-off properly now that the bug is fixed."
  },

  "pipeline.bg_var_threshold": {
    "values": [4, 8, 16, 32, 64],
    "rationale": "Core sweep-3 parameter — was never applied in sweeps 1 and 2 due to key-name bug (var_threshold vs varThreshold). Moving animals: lower vT = more sensitive = better (sweep-2 apparent winner: 8). Static animals: higher vT = pixel must match background model more closely before being absorbed = slower absorption = better detection. Now testing for real."
  },

  "pipeline.bg_detect_shadows": {
    "values": [0, 1],
    "rationale": "Was never applied in sweeps 1 and 2 (key-name bug). detectShadows=1 marks shadow pixels (127) separately from foreground (255). For dark animals on light floors the animal shadow may appear as foreground and merge with the animal blob. Testing both to see if shadow detection helps or hurts accuracy."
  }
}
